.park-page { padding: 24rpx; }
.park-tabs {
  display: flex;
  white-space: nowrap;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
}
.park-tab {
  display: inline-block;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  font-weight: 400;
  color: #666;
  border-radius: 10rpx;
  border-bottom: 4rpx solid transparent;
  transition: all 0.15s;
}
.park-tab.active {
  color: #165DFF;
  font-weight: 600;
  border-bottom-color: #165DFF;
}

.info-card {
  background: linear-gradient(135deg, #165DFF, #4080FF);
  border-radius: 24rpx; padding: 40rpx 32rpx; color: #fff; margin-bottom: 24rpx;
}
.park-name { font-size: 38rpx; font-weight: 700; display: block; margin-bottom: 12rpx; }
.park-address { font-size: 24rpx; opacity: 0.8; display: block; margin-bottom: 20rpx; }
.park-desc { font-size: 26rpx; opacity: 0.9; line-height: 1.7; }

.section { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 20rpx; }
.section-title {
  font-size: 30rpx; font-weight: 600; color: #1A1A1A; display: block;
  margin-bottom: 20rpx; padding-bottom: 16rpx; border-bottom: 2rpx solid #EBEDF0;
}

.facility-list { display: flex; flex-wrap: wrap; justify-content: space-between; }
.facility-card {
  width: 48%; display: flex; flex-direction: column;
  align-items: center; text-align: center; padding: 20rpx; box-sizing: border-box;
  margin-bottom: 20rpx;
}
.facility-icon { width: 64rpx; height: 64rpx; margin-bottom: 12rpx; }
.facility-name { font-size: 26rpx; font-weight: 500; color: #1A1A1A; margin-bottom: 8rpx; }
.facility-desc { font-size: 22rpx; color: #999; line-height: 1.5; }

.honor-list { display: flex; flex-wrap: wrap; }
.honor-card {
  width: 33%; display: flex; flex-direction: column;
  align-items: center; padding: 16rpx; box-sizing: border-box;
  margin-bottom: 16rpx;
}
.honor-img { width: 100rpx; height: 80rpx; margin-bottom: 8rpx; }
.honor-name { font-size: 22rpx; color: #666; text-align: center; }

.transport-text { font-size: 26rpx; color: #666; line-height: 1.7; }
.loading { text-align: center; color: #999; padding: 100rpx 0; }

.detail-page { padding: 24rpx; }
.info-card, .steps-card, .price-card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 20rpx; }
.detail-title { font-size: 36rpx; font-weight: 700; color: #1A1A1A; display: block; margin-bottom: 16rpx; }
.detail-meta { display: flex; margin-bottom: 20rpx; }
.meta-tag { font-size: 22rpx; color: #165DFF; background: #E8F4FF; padding: 6rpx 16rpx; border-radius: 6rpx; margin-right: 16rpx; }
.meta-enterprise { font-size: 22rpx; color: #999; padding: 6rpx 16rpx; }
.detail-desc { font-size: 28rpx; color: #666; line-height: 1.8; }

.card-title { font-size: 30rpx; font-weight: 600; color: #1A1A1A; display: block; margin-bottom: 24rpx; padding-bottom: 16rpx; border-bottom: 2rpx solid #EBEDF0; }
.steps-list { display: flex; flex-direction: column; }
.step-item { display: flex; margin-bottom: 24rpx; }
.step-num {
  width: 44rpx; height: 44rpx; border-radius: 50%; background: #165DFF;
  color: #fff; font-size: 24rpx; display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; margin-top: 4rpx; margin-right: 20rpx;
}
.step-title { font-size: 28rpx; font-weight: 500; color: #1A1A1A; display: block; margin-bottom: 8rpx; }
.step-desc { font-size: 24rpx; color: #999; line-height: 1.6; }

.price-row { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid #EBEDF0; }
.price-label { font-size: 26rpx; color: #666; }
.price-value { font-size: 26rpx; color: #1A1A1A; }
.price-value.subsidy { color: #00B578; }

.action-card { margin-top: 20rpx; }
.apply-btn {
  height: 88rpx; border-radius: 12rpx;
  background: linear-gradient(135deg, #165DFF, #4080FF);
  color: #fff; font-size: 32rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
}

.qr-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 100;
}
.qr-dialog { background: #fff; border-radius: 24rpx; width: 500rpx; padding: 48rpx; display: flex; flex-direction: column; align-items: center; }
.qr-title { font-size: 32rpx; font-weight: 600; margin-bottom: 32rpx; }
.qr-img { width: 320rpx; margin-bottom: 24rpx; }
.qr-empty { color: #999; padding: 60rpx 0; }
.apply-form { width: 100%; margin-top: 24rpx; }
.apply-form .form-group { margin-bottom: 16rpx; }
.apply-form .label { font-size: 26rpx; color: #1A1A1A; display: block; margin-bottom: 8rpx; }
.apply-form input {
  height: 72rpx; background: #F5F6FA; border-radius: 10rpx; padding: 0 16rpx; font-size: 26rpx; width: 100%; box-sizing: border-box;
}
.qr-submit {
  width: 240rpx; height: 72rpx; border-radius: 36rpx;
  background: linear-gradient(135deg, #165DFF, #4080FF);
  color: #fff; font-size: 28rpx; display: flex; align-items: center; justify-content: center;
  margin-bottom: 20rpx;
}
.qr-close {
  width: 240rpx; height: 72rpx; border-radius: 36rpx; border: 2rpx solid #165DFF;
  color: #165DFF; font-size: 28rpx; display: flex; align-items: center; justify-content: center;
}
.loading { text-align: center; color: #999; padding: 100rpx 0; }

<view class="service-page">
  <scroll-view scroll-x class="category-bar">
    <view class="category-list">
      <view class="category-item {{activeCategory === '' ? 'active' : ''}}" data-id="" bindtap="switchCategory">全部</view>
      <view wx:for="{{categories}}" wx:key="id"
        class="category-item {{activeCategory === item.id ? 'active' : ''}}"
        data-id="{{item.id}}" bindtap="switchCategory">{{item.categoryName}}</view>
    </view>
  </scroll-view>

  <view class="search-row">
    <input value="{{keyword}}" placeholder="搜索服务" confirm-type="search" show-clear bindinput="onSearchInput" bindconfirm="doSearch"/>
    <view class="search-btn" bindtap="doSearch">搜索</view>
  </view>

  <view class="service-list">
    <view wx:for="{{list}}" wx:key="id" class="service-card" data-id="{{item.id}}" bindtap="goDetail">
      <view class="card-top">
        <text class="card-title">{{item.serviceName}}</text>
        <text class="card-category">{{item.categoryName}}</text>
      </view>
      <text class="card-desc">{{item.summary}}</text>
      <text class="card-enterprise">{{item.applicableEnterprise || '适用各类企业'}}</text>
    </view>
  </view>

  <view wx:if="{{list.length === 0}}" class="empty">暂无服务</view>
  <view wx:elif="{{hasMore}}" class="load-more" bindtap="loadMore">加载更多</view>
  <view wx:else class="no-more">— 没有更多了 —</view>
</view>

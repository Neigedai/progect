.article-page { padding-bottom: 32rpx; }
.type-bar { display: flex; justify-content: center; padding: 20rpx 0; background: #fff; }
.type-item {
  font-size: 26rpx; color: #666; padding: 10rpx 28rpx; border-radius: 32rpx; background: #F5F6FA;
  margin: 0 12rpx;
}
.type-item.active { background: #165DFF; color: #fff; }

.search-row { display: flex; align-items: center; margin: 16rpx 24rpx; }
.search-row input { flex: 1; height: 72rpx; background: #fff; border-radius: 36rpx; padding: 0 24rpx; font-size: 26rpx; }
.search-btn {
  width: 120rpx; height: 72rpx; border-radius: 36rpx; background: #165DFF;
  color: #fff; font-size: 26rpx; display: flex; align-items: center; justify-content: center;
  margin-left: 16rpx;
}

.article-list { padding: 0 24rpx; display: flex; flex-direction: column; }
.article-card { background: #fff; border-radius: 16rpx; padding: 24rpx; display: flex; margin-bottom: 16rpx; }
.article-img { width: 200rpx; height: 140rpx; border-radius: 12rpx; flex-shrink: 0; margin-right: 20rpx; }
.article-info { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.article-title {
  font-size: 28rpx; color: #1A1A1A; font-weight: 500; line-height: 1.5; margin-bottom: 8rpx;
  overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}
.article-summary {
  font-size: 24rpx; color: #999; line-height: 1.5; margin-bottom: 12rpx;
  overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}
.article-meta { display: flex; justify-content: space-between; align-items: center; }
.meta-date { font-size: 22rpx; color: #999; }
.meta-type { font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 6rpx; }
.meta-type.policy { background: #FFF0E6; color: #FF8F1F; }
.meta-type.news { background: #E8F4FF; color: #165DFF; }

.empty { text-align: center; color: #999; padding: 80rpx 0; }
.load-more { text-align: center; color: #165DFF; padding: 24rpx; font-size: 26rpx; }
.no-more { text-align: center; color: #999; padding: 24rpx; font-size: 24rpx; }

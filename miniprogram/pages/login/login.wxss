.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #165DFF 0%, #4080FF 50%, #F5F6FA 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx 0;
}
.login-header { display: flex; flex-direction: column; align-items: center; margin-bottom: 60rpx; }
.login-logo {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: rgba(255,255,255,0.2);
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 24rpx; font-size: 56rpx; font-weight: bold; color: #fff;
}
.login-title { font-size: 40rpx; font-weight: 700; color: #fff; margin-bottom: 12rpx; }
.login-subtitle { font-size: 26rpx; color: rgba(255,255,255,0.8); }
.login-card {
  width: 100%; background: #fff; border-radius: 24rpx;
  padding: 40rpx 36rpx; box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.08);
  box-sizing: border-box;
}
.login-tabs { display: flex; margin-bottom: 40rpx; border-bottom: 2rpx solid #EBEDF0; }
.tab-item {
  flex: 1; text-align: center; padding: 20rpx 0;
  font-size: 30rpx; color: #999; position: relative;
}
.tab-item.active { color: #165DFF; font-weight: 600; }
.tab-item.active::after {
  content: ''; position: absolute; bottom: -2rpx; left: 50%;
  transform: translateX(-50%); width: 60rpx; height: 4rpx;
  background: #165DFF; border-radius: 2rpx;
}
.login-form { display: flex; flex-direction: column; }
.login-form .input-group { margin-bottom: 24rpx; }
.input-group { background: #F5F6FA; border-radius: 12rpx; padding: 0 24rpx; }
.input-group input { height: 88rpx; font-size: 28rpx; color: #333; width: 100%; }
.code-group { display: flex; align-items: center; }
.code-input { flex: 1; }
.code-btn {
  font-size: 26rpx; color: #165DFF; white-space: nowrap;
  padding-left: 16rpx; border-left: 2rpx solid #ddd;
}
.code-btn.disabled { color: #999; }
.login-btn {
  height: 88rpx; border-radius: 12rpx;
  background: linear-gradient(135deg, #165DFF, #4080FF);
  color: #fff; font-size: 32rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  margin-top: 16rpx;
}
.login-footer { margin-top: 40rpx; font-size: 22rpx; color: rgba(255,255,255,0.7); }

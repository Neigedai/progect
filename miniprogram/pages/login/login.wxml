<view class="login-page">
  <view class="login-header">
    <view class="login-logo">
      <text>P</text>
    </view>
    <text class="login-title">园区服务运营系统</text>
    <text class="login-subtitle">企业服务一站式平台</text>
  </view>

  <view class="login-card">
    <view class="login-tabs">
      <view class="tab-item {{tab === 'phone' ? 'active' : ''}}" data-tab="phone" bindtap="switchTab">手机号登录</view>
      <view class="tab-item {{tab === 'password' ? 'active' : ''}}" data-tab="password" bindtap="switchTab">账号密码登录</view>
    </view>

    <!-- 手机号登录 -->
    <view wx:if="{{tab === 'phone'}}" class="login-form">
      <view class="input-group">
        <input value="{{phone}}" type="number" maxlength="11" placeholder="请输入手机号" show-clear bindinput="onPhoneInput"/>
      </view>
      <view class="input-group code-group">
        <input value="{{code}}" type="number" maxlength="6" placeholder="验证码" class="code-input" show-clear bindinput="onCodeInput"/>
        <view class="code-btn {{counting ? 'disabled' : ''}}" bindtap="handleSendCode">
          {{counting ? countdown + 's' : '获取验证码'}}
        </view>
      </view>
      <view class="login-btn" bindtap="handlePhoneLogin">登录 / 注册</view>
    </view>

    <!-- 密码登录 -->
    <view wx:else class="login-form">
      <view class="input-group">
        <input value="{{username}}" placeholder="请输入用户名" show-clear bindinput="onUsernameInput"/>
      </view>
      <view class="input-group">
        <input value="{{password}}" password placeholder="请输入密码" show-clear bindinput="onPasswordInput"/>
      </view>
      <view class="login-btn" bindtap="handlePasswordLogin">登录</view>
    </view>
  </view>

  <view class="login-footer">
    <text>登录即表示同意《用户服务协议》和《隐私政策》</text>
  </view>
</view>

.mine-page { padding: 24rpx; }
.user-card {
  background: linear-gradient(135deg, #165DFF, #4080FF);
  border-radius: 24rpx; padding: 48rpx 32rpx; display: flex; align-items: center;
  margin-bottom: 24rpx;
}
.avatar {
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center;
  font-size: 44rpx; font-weight: 700; color: #fff;
  margin-right: 24rpx;
}
.user-name { font-size: 34rpx; font-weight: 600; color: #fff; display: block; margin-bottom: 6rpx; }
.user-phone { font-size: 24rpx; color: rgba(255,255,255,0.8); }

.menu-card { background: #fff; border-radius: 16rpx; margin-bottom: 20rpx; overflow: hidden; }
.menu-item { display: flex; align-items: center; padding: 28rpx; border-bottom: 1rpx solid #EBEDF0; position: relative; }
.menu-item:last-child { border-bottom: none; }
.menu-icon { width: 40rpx; height: 40rpx; margin-right: 20rpx; }
.menu-label { flex: 1; font-size: 28rpx; color: #1A1A1A; }
.menu-arrow { font-size: 24rpx; color: #ccc; }
.badge {
  min-width: 36rpx; height: 36rpx; border-radius: 18rpx; background: #FF3141;
  color: #fff; font-size: 20rpx; display: flex; align-items: center; justify-content: center;
  padding: 0 8rpx; margin-right: 16rpx;
}

.logout-btn {
  height: 88rpx; background: #fff; border-radius: 12rpx; color: #FF3141;
  font-size: 30rpx; display: flex; align-items: center; justify-content: center; margin-top: 40rpx;
}

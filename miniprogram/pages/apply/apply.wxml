<view class="apply-page">
  <view class="form-card">
    <text class="form-title">入驻申请</text>
    <text class="form-desc">填写以下信息，园区管理员将尽快与您联系</text>

    <view wx:if="{{showForm}}">
      <view class="form-group">
        <text class="label">入驻地点 <text class="required">*</text></text>
        <picker mode="selector" range="{{locations}}" value="{{locationIdx}}" bindchange="onLocationChange">
          <view class="picker-val {{form.location ? '' : 'placeholder'}}">
            {{form.location || '请选择入驻地点'}}
          </view>
        </picker>
      </view>

      <view class="form-group">
        <text class="label">企业名称 <text class="required">*</text></text>
        <input value="{{form.companyName}}" placeholder="请输入企业全称" show-clear data-field="companyName" bindinput="onInput"/>
      </view>

      <view class="form-group">
        <text class="label">营业执照</text>
        <view class="upload-row">
          <image wx:if="{{form.businessLicenseUrl}}" src="{{form.businessLicenseUrl}}" mode="aspectFit" class="id-preview" bindtap="chooseLicense" />
          <view wx:else class="upload-btn" bindtap="chooseLicense">
            <text class="upload-icon">+</text>
            <text class="upload-text">上传营业执照</text>
          </view>
        </view>
      </view>

      <view class="form-group">
        <text class="label">法人姓名 <text class="required">*</text></text>
        <input value="{{form.legalPersonName}}" placeholder="请输入法人姓名" show-clear data-field="legalPersonName" bindinput="onInput"/>
      </view>

      <view class="form-group">
        <text class="label">本人手机号 <text class="required">*</text></text>
        <input value="{{form.legalPersonPhone}}" type="number" maxlength="11" placeholder="请输入手机号" disabled data-field="legalPersonPhone" bindinput="onInput"/>
      </view>

      <view class="form-group">
        <text class="label">身份证正面</text>
        <view class="upload-row">
          <image wx:if="{{form.legalPersonIdFront}}" src="{{form.legalPersonIdFront}}" mode="aspectFit" class="id-preview" bindtap="chooseIdFront" />
          <view wx:else class="upload-btn" bindtap="chooseIdFront">
            <text class="upload-icon">+</text>
            <text class="upload-text">上传正面</text>
          </view>
        </view>
      </view>

      <view class="form-group">
        <text class="label">身份证反面</text>
        <view class="upload-row">
          <image wx:if="{{form.legalPersonIdBack}}" src="{{form.legalPersonIdBack}}" mode="aspectFit" class="id-preview" bindtap="chooseIdBack" />
          <view wx:else class="upload-btn" bindtap="chooseIdBack">
            <text class="upload-icon">+</text>
            <text class="upload-text">上传反面</text>
          </view>
        </view>
      </view>

      <view class="form-group">
        <text class="label">应急联系人姓名 <text class="required">*</text></text>
        <input value="{{form.emergencyContactName}}" placeholder="请输入应急联系人姓名" show-clear data-field="emergencyContactName" bindinput="onInput"/>
      </view>

      <view class="form-group">
        <text class="label">应急联系人手机号 <text class="required">*</text></text>
        <input value="{{form.emergencyContactPhone}}" type="number" maxlength="11" placeholder="请输入应急联系人手机号" show-clear data-field="emergencyContactPhone" bindinput="onInput"/>
      </view>

      <view class="form-group">
        <text class="label">企业类型 <text class="required">*</text></text>
        <picker mode="selector" range="{{enterpriseTypes}}" value="{{enterpriseTypeIdx}}" bindchange="onEnterpriseTypeChange">
          <view class="picker-val {{form.enterpriseType !== null ? '' : 'placeholder'}}">
            {{form.enterpriseType !== null ? enterpriseTypes[enterpriseTypeIdx] : '请选择企业类型'}}
          </view>
        </picker>
      </view>

      <view class="form-group">
        <text class="label">企业赛道 <text class="required">*</text></text>
        <picker mode="selector" range="{{enterpriseTracks}}" value="{{enterpriseTrackIdx}}" bindchange="onEnterpriseTrackChange">
          <view class="picker-val {{form.enterpriseTrack ? '' : 'placeholder'}}">
            {{form.enterpriseTrack || '请选择企业赛道'}}
          </view>
        </picker>
      </view>

      <view class="form-group agree-row" bindtap="toggleAgree">
        <view class="agree-check {{form.agreed ? 'checked' : ''}}">
          <text wx:if="{{form.agreed}}" class="check-icon">✓</text>
        </view>
        <text class="agree-text">本人自愿申请入驻，并知悉上述企业开办流程及法律规定，以上信息均真实有效，特此承诺！</text>
      </view>

      <view class="submit-btn" bindtap="handleSubmit">提交申请</view>
    </view>

    <view wx:else class="new-apply-box">
      <view class="new-apply-btn" bindtap="onNewApply">填写新的入驻申请</view>
    </view>
  </view>

  <view wx:if="{{myList.length}}" class="list-card">
    <text class="list-title">我的申请记录</text>
    <view wx:for="{{myList}}" wx:key="id" class="list-item">
      <view class="item-row">
        <text class="item-label">{{item.companyName || '未填写企业名称'}}</text>
        <view class="item-status {{item.status === 'approved' ? 'status-ok' : item.status === 'rejected' ? 'status-no' : 'status-pending'}}">
          {{item.status === 'approved' ? '已通过' : item.status === 'rejected' ? '已驳回' : '待审核'}}
        </view>
      </view>
      <view class="item-row">
        <text class="item-info">{{item.location}}</text>
        <text class="item-info">{{item.createTime}}</text>
      </view>
      <view wx:if="{{item.status === 'rejected' && item.reviewComment}}" class="reject-reason">驳回原因：{{item.reviewComment}}</view>
    </view>
  </view>
</view>

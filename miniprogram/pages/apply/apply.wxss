.apply-page { padding: 24rpx; }
.form-card { background: #fff; border-radius: 24rpx; padding: 36rpx 28rpx; }
.form-title { font-size: 36rpx; font-weight: 700; color: #1A1A1A; display: block; }
.form-desc { font-size: 24rpx; color: #999; display: block; margin: 12rpx 0 32rpx; }
.form-group { margin-bottom: 28rpx; }
.label { font-size: 28rpx; color: #1A1A1A; display: block; margin-bottom: 12rpx; }
.required { color: #FF3141; }
.form-group input {
  height: 80rpx; background: #F5F6FA; border-radius: 12rpx; padding: 0 20rpx; font-size: 28rpx; width: 100%; box-sizing: border-box;
}
.form-group textarea {
  width: 100%; height: 160rpx; background: #F5F6FA; border-radius: 12rpx;
  padding: 16rpx 20rpx; font-size: 28rpx; box-sizing: border-box;
}
.picker-val {
  height: 80rpx; background: #F5F6FA; border-radius: 12rpx; padding: 0 20rpx;
  font-size: 28rpx; display: flex; align-items: center;
}
.picker-val.placeholder { color: #ccc; }
.submit-btn {
  height: 88rpx; border-radius: 12rpx;
  background: linear-gradient(135deg, #165DFF, #4080FF);
  color: #fff; font-size: 32rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center; margin-top: 40rpx;
}

.list-card { background: #fff; border-radius: 24rpx; padding: 36rpx 28rpx; margin-top: 24rpx; }
.list-title { font-size: 32rpx; font-weight: 700; color: #1A1A1A; display: block; margin-bottom: 24rpx; }
.list-item { border-bottom: 1rpx solid #F0F0F0; padding: 20rpx 0; }
.list-item:last-child { border-bottom: none; }
.item-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.item-label { font-size: 28rpx; color: #1A1A1A; font-weight: 500; }
.item-info { font-size: 24rpx; color: #999; }
.item-status { font-size: 24rpx; padding: 4rpx 16rpx; border-radius: 8rpx; }
.status-pending { color: #E6A23C; background: #FDF6EC; }
.status-ok { color: #67C23A; background: #F0F9EB; }
.status-no { color: #F56C6C; background: #FEF0F0; }

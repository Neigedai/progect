.survey-page { padding: 24rpx; }
.survey-header { text-align: center; padding: 32rpx 0 20rpx; }
.survey-title { font-size: 34rpx; font-weight: 700; color: #1A1A1A; display: block; }
.survey-desc { font-size: 24rpx; color: #999; display: block; margin-top: 12rpx; line-height: 1.6; }
.status-text { text-align: center; padding: 120rpx 0; font-size: 28rpx; color: #666; }
.form-card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-top: 20rpx; }
.section-title { font-size: 30rpx; font-weight: 600; color: #165DFF; padding: 24rpx 0 12rpx; border-bottom: 2rpx solid #e8f4ff; margin-bottom: 16rpx; }
.form-group { margin-bottom: 20rpx; }
.form-group .label { font-size: 26rpx; color: #1A1A1A; display: block; margin-bottom: 10rpx; }
.form-group input, .form-group textarea {
  width: 100%; height: 76rpx; background: #F5F6FA; border-radius: 10rpx;
  padding: 0 18rpx; font-size: 26rpx; box-sizing: border-box;
}
.form-group textarea { height: 160rpx; padding: 14rpx 18rpx; }
.q-item { padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.q-text { font-size: 26rpx; color: #333; margin-bottom: 12rpx; display: block; }
.q-options { display: flex; flex-wrap: wrap; gap: 16rpx; }
.q-opt { padding: 10rpx 28rpx; border-radius: 8rpx; border: 1rpx solid #ddd; font-size: 24rpx; color: #666; background: #fff; }
.q-opt.active { border-color: #165DFF; color: #fff; background: #165DFF; }
.submit-btn {
  height: 88rpx; border-radius: 12rpx; margin-top: 40rpx;
  background: linear-gradient(135deg, #165DFF, #4080FF);
  color: #fff; font-size: 32rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
}
